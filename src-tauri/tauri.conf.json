{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SETLIST",
  "mainBinaryName": "SETLIST",
  "version": "0.1.0",
  "identifier": "com.setlist.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui exec vite build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SETLIST",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
